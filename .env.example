NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/repo_intelligence
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=7d

# Embeddings provider (pluggable — see src/embeddings/providers)
# "onnx"   — default. Runs a real model locally via @xenova/transformers,
#            no API key, free. First call downloads and caches the model.
# "openai" — needs OPENAI_API_KEY.
# "ollama" — needs a local Ollama server running with the model pulled
#            (`ollama pull nomic-embed-text`).
# "stub"   — deterministic, no-op vectors with no real semantic meaning;
#            for fast tests/CI only.
#
# EMBEDDING_DIMENSIONS must match whichever provider is active:
#   onnx/all-MiniLM-L6-v2 = 384, openai/text-embedding-3-small = 1536,
#   ollama/nomic-embed-text = 768. Changing provider/dimensions after
#   chunks exist requires re-running the chunks migration and re-indexing
#   (see docs/architecture.md).
EMBEDDINGS_PROVIDER=onnx
ONNX_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Must be writable — @xenova/transformers' own default cache location is
# inside its node_modules install path, which is read-only for the
# non-root user in the Docker image.
ONNX_CACHE_DIR=./.cache
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_TTL_SECONDS=2592000

# Where cloned repositories are checked out for analysis. Must be writable.
WORKSPACE_DIR=./.workspace

# Origin the dashboard is served from — CORS is scoped to exactly this,
# not a wildcard. Default matches the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# Off by default. Turns on a read-only public-demo mode: registration and
# every mutating repository action (create/delete/re-index) are blocked
# outright regardless of who's asking, and browsing the one repo already
# seeded doesn't require logging in at all. See scripts/seed-demo-repo.sh
# for the seed-then-flip-this-on workflow — never turn this on before
# seeding, since seeding itself needs the normal (blocked-in-demo-mode)
# register + create flow.
DEMO_MODE=false

# LLM provider for `ask` (pluggable, same pattern as embeddings above).
# "ollama"  — default. Needs a local Ollama server with the model pulled
#             (`ollama pull llama3.2`). Free, no API key.
# "openai"  — needs OPENAI_API_KEY (same key as the embeddings provider).
# "stub"    — deterministic canned response; for fast tests/CI only.
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=llama3.2
OPENAI_LLM_MODEL=gpt-4o-mini
LLM_CACHE_TTL_SECONDS=2592000
