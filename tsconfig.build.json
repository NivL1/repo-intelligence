{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pinned explicitly rather than left to inference. TypeScript
    // otherwise infers rootDir as the longest common path of every
    // compiled input, src/ included — and that set has repeatedly
    // included something outside src/ by accident (the eval/ dev
    // harness, the client/ dashboard, even `import ... from
    // '../package.json'` in main.ts for the Swagger version), each time
    // silently moving the compiled entrypoint from dist/main.js to
    // dist/<wherever>/main.js and breaking `node dist/main.js` in the
    // runtime image with no compile-time error to catch it. Pinning
    // rootDir makes that whole failure class impossible instead of
    // chasing it exclusion by exclusion.
    "rootDir": "./src"
  },
  // `eval` and `client` (the dashboard, its own separate Vite/React
  // project) have no place in the production image regardless of rootDir.
  "exclude": ["node_modules", "test", "eval", "client", "dist", "**/*spec.ts"]
}
