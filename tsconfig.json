{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true
  },
  // `client/` (the Vite/React dashboard) and `mcp/` (the MCP server) are
  // separate packages, each with its own tsconfig, module resolution and
  // node_modules — neither must ever be picked up by the backend's
  // compiler. tsconfig.build.json's own `exclude` replaces this one
  // entirely rather than merging with it, so both (and `eval`, `test`)
  // have to be listed there too, not just here.
  "exclude": ["node_modules", "client", "mcp"]
}
